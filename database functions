def query_db(query, params=()):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute(query, params)
    result = cursor.fetchone()
    conn.close()
    return result

# ---------------- AGENT FUNCTIONS ----------------

def explain_medicine(name):
    data = query_db(
        f"""SELECT medicine_name, strength, use, dose_instructions
            FROM {TABLE_NAME}
            WHERE LOWER(medicine_name)=LOWER(?)""",
        (name,)
    )
    if not data:
        return "🔍 Medicine not found in the dataset."

    return f"""
**Medicine:** {data[0]}  
**Strength:** {data[1]}  
**Used for:** {data[2]}  
**Dose:** {data[3]}  
"""


def check_stock(name):
    data = query_db(
        f"""SELECT availability, alternative FROM {TABLE_NAME}
            WHERE LOWER(medicine_name)=LOWER(?)""",
        (name,)
    )
    if not data:
        return "🔍 Medicine not found in the dataset."

    availability, alternatives = data

    if availability == 1:
        return "✅ This medicine is currently in stock."

    # Friendly guidance if out of stock
    guidance = "⚠️ This medicine is temporarily unavailable.\n"
    if alternatives:
        alts_list = alternatives.split("|")
        guidance += "💡 You may consider these alternatives: " + ", ".join(alts_list) + ".\n"
    guidance += "🛒 Please check with your pharmacist or doctor for safe usage and timing."
    return guidance


def suggest_alternatives(name):
    data = query_db(
        f"""SELECT alternative FROM {TABLE_NAME}
            WHERE LOWER(medicine_name)=LOWER(?)""",
        (name,)
    )
    if not data or not data[0]:
        return "⚠️ No alternatives listed. Please consult your pharmacist."

    alts = data[0].split("|")
    return "🔁 Suggested alternatives: " + ", ".join(alts)


def faq_answer(name):
    data = query_db(
        f"""SELECT use, dose_instructions FROM {TABLE_NAME}
            WHERE LOWER(medicine_name)=LOWER(?)""",
        (name,)
    )
    if not data:
        return "🔍 Medicine not found in the dataset."

    return f"""
**Frequently Asked Info**  
• **Used for:** {data[0]}  
• **How to take:** {data[1]}  
⚠️ Always follow the doctor's instructions for dosage and duration.
"""

